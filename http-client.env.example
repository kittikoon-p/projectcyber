# -----------------------------------------------------------------------------
# http-client.env  - ตัวแปรร่วมสำหรับไฟล์ http/*.http ทุกไฟล์
#
# VS Code:  ติดตั้ง "REST Client" (humao.rest-client) จากนั้นกด "Send" ได้เลย
#           ไฟล์ .http จะโหลดไฟล์นี้อัตโนมัติเมื่อไฟล์นี้อยู่ติดกับพวกมัน
# JetBrains: Settings > Editor > HTTP Client > environment files
# CLI:       npx rest-client --env-var-file http-client.env http/00-auth.http
#
# ขั้นตอนที่ 1: รัน scripts/setup-bwapp.ps1 จากนั้นล็อกอินด้วยคำขอใน
#         http/00-auth.http แล้วคัดลอกค่าจาก Set-Cookie ไปใส่ใน @session ด้านล่าง
# -----------------------------------------------------------------------------

# อินสแตนซ์ bWAPP ที่ใช้ทดสอบ
@baseUrl = http://127.0.0.1:8443

# ค่า PHPSESSID จาก login.php (ดู http/00-auth.http)
# เว้นว่างไว้โดยตั้งใจ - เป็นเซสชันแหบทิ้งใช้ใน security lab และ Run-HttpFile.ps1
# จะล็อกอินเองอยู่แล้ว setup-bwapp.ps1 กับ Run-HttpFile.ps1 -UpdateEnv จะเป็นผู้กรอกให้
@session =

# cookie "security level" ของ bWAPP 0 = ต่ำ (เปราะบางเต็มรูปแบบ), 1 = กลาง, 2 = สูง
# นี่คือ cookie ฝั่ง client ซึ่งเป็นตัวข้อค้นพบ BWAPP-INFO-09 ในตัวมันเอง
@securityLevel = 0

# ข้อมูลรับรองคงที่ของ bWAPP (ถูกเผยแพร่แบบไม่ต้องยืนยันตัวตนที่ /admin/ อีกด้วย)
@bwappUser = bee
@bwappPass = bug

# SHA1("bug") - ค่า hash ที่เรากู้คืนได้ในข้อค้นพบชุด SQLi
@beeHash = 6885858486f31043e5839c735d99457f045affd0

# Cookies ที่หน้าเว็บซึ่งมีช่องโหว่คาดหวัง
@authCookie =