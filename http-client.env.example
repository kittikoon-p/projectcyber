# -----------------------------------------------------------------------------
# http-client.env  - shared variables for every http/*.http file
#
# VS Code:  install "REST Client" (humao.rest-client) then just press "Send".
#           .http files auto-load this file when it sits next to them.
# JetBrains: Settings > Editor > HTTP Client > environment files
# CLI:       npx rest-client --env-var-file http-client.env http/00-auth.http
#
# STEP 1: run scripts/setup-bwapp.ps1, then log in with the request in
#         http/00-auth.http and copy the Set-Cookie value into @session below.
# -----------------------------------------------------------------------------

# bWAPP instance under test
@baseUrl = http://127.0.0.1:8080

# PHPSESSID value from login.php (see http/00-auth.http)
# Left blank on purpose - it is a throwaway lab session, and Run-HttpFile.ps1
# logs in on its own. setup-bwapp.ps1 and Run-HttpFile.ps1 -UpdateEnv fill it in.
@session =

# bWAPP "security level" cookie. 0 = low (fully vulnerable), 1 = medium, 2 = high.
# This is a client-side cookie, which is itself finding BWAPP-INFO-09.
@securityLevel = 0

# bWAPP static credentials (also published unauthenticated on /admin/)
@bwappUser = bee
@bwappPass = bug

# SHA1("bug") - the hash we recover in the SQLi findings
@beeHash = 6885858486f31043e5839c735d99457f045affd0

# Cookies the vulnerable pages expect
@authCookie =