# ทำให้ line ending ใน repository เป็นมาตรฐานเดียวกัน และ checkout ตามแต่ละแพลตฟอร์ม
* text=auto

# ไฟล์ PowerShell และไฟล์คำขอ HTTP ถูกแก้ไขบน Windows เท่านั้น
*.ps1  text eol=crlf
*.http text eol=crlf
*.env  text eol=crlf

# Evidence เป็นข้อความที่ถูกสร้างขึ้น จึงตัดออกจาก diff ทั้งหมด (ดู .gitignore)
evidence/** binary
